# =================================================================
# EmbedX 2026 Registration Platform — Railway & Production Environment Config
# =================================================================

# Railway automatically sets PORT in production environment
# PORT=8080

# MongoDB Atlas Connection URI
MONGODB_URI="non srv URI"

# Admin Security Passkey (View-only: registrations, receipts, leaderboard)
ADMIN_PASSWORD=embedx_admin@2026

# Super Admin Security Passkey (Full access: approve/reject, settings, score edits, panels)
SUPER_ADMIN_PASS=admin_rc@2026

# App Public Domain (Used for absolute URLs in email notifications & links)
# Set to your Railway service domain: e.g. https://embedx-production.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Railway Persistent Storage Volume Path (Optional - defaults to ./public/uploads/receipts)
# Example Railway Volume Mount Path: /app/public/uploads/receipts
UPLOAD_DIR=/app/public/uploads/receipts

# SMTP Email Dispatch Credentials (Nodemailer)
# If not configured, emails will be safely logged/simulated in server terminal console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=roboticsclub@mmmut.ac.in
SMTP_PASS=your_app_password_here
EMAIL_FROM="Robotics Club MMMUT" <roboticsclub@mmmut.ac.in>
